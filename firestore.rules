rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // Admin membership is managed manually in Firebase Console.
    // A signed-in user can only verify their own membership document.
    match /adminUsers/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Public pages may read published content; only allowlisted admins can write.
    match /{collectionName}/{documentId} {
      allow read: if isAdmin()
        || (collectionName in ['services', 'projects', 'blogPosts']
            && resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }
  }
}
